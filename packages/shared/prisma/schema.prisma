generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH MODELS
// ============================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  users       User[]
  isProtected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id       String  @id @default(uuid())
  email    String? @unique
  name     String?
  username String  @unique

  isBlocked       Boolean   @default(false)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  supabaseUserId  String?   @unique

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  isDelete          Boolean    @default(false)
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")

  @@index([roleId])
}

// ============================================
// TAXONOMY MODELS
// ============================================
enum CategoryType {
  AUTO
  MANUAL
}

enum LayoutType {
  CAROUSEL
  GRID
  RANKED_LIST
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Category {
  id            String  @id @default(uuid())
  name          String  @db.VarChar(100)
  slug          String  @unique @db.VarChar(150)
  subtitle      String? @db.VarChar(255)
  description   String?
  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)

  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  type       CategoryType
  layoutType LayoutType     @map("layout_type")
  status     CategoryStatus @default(DRAFT)

  displayOrder Int     @default(0) @map("display_order")
  isPinned     Boolean @default(false) @map("is_pinned")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdById String @map("created_by")
  updatedById String @map("updated_by")

  createdBy User @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@index([status, displayOrder])
  @@index([slug])
  @@map("categories")
}
